{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "languages.schema.json",
  "title": "Sprachen (languages.yaml)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "flag", "tts_locale", "base", "learnable"],
    "properties": {
      "code": {"type": "string", "pattern": "^[a-z]{2,3}$"},
      "flag": {"type": "string", "minLength": 1, "maxLength": 16},
      "tts_locale": {"type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$"},
      "base": {"type": "boolean"},
      "learnable": {"type": "boolean"}
    }
  }
}
